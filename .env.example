# ─────────────────────────────────────────────────────────────────────
# Credenciais do Astrea (https://astrea.net.br)
# ─────────────────────────────────────────────────────────────────────
ASTREA_EMAIL=seu@email.com
ASTREA_PASSWORD=sua_senha_aqui

# ─────────────────────────────────────────────────────────────────────
# Autenticação da API (gere uma chave segura com: openssl rand -hex 32)
#
# Defina API_KEY (chave única, legada) E/OU API_KEYS (lista multi-chave,
# recomendada — uma chave por pessoa, com rótulo para auditoria/revogação).
# Formato de API_KEYS: chave[:label],chave[:label],...  (≥32 chars por chave)
# O label aparece nos logs de auditoria; a chave nunca é logada.
# ─────────────────────────────────────────────────────────────────────
API_KEY=gere_uma_chave_segura_aqui_com_pelo_menos_32_chars
# API_KEYS=chave_de_32_chars_ou_mais:fulano,outra_chave_de_32_chars:beltrano

# ─────────────────────────────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
TRUST_PROXY=0

# ─────────────────────────────────────────────────────────────────────
# Pool de Browsers (Playwright)
# ─────────────────────────────────────────────────────────────────────
# Número máximo de abas ativas simultâneas (1..5).
# Cada aba extra custa ~250 MB RAM E aumenta o risco da Astrea detectar
# uso indevido da conta (múltiplas abas paralelas na mesma sessão logada).
# 3 cobre o caso saudável; 5 é o teto para picos legítimos (múltiplos
# colaboradores + cron noturno). NÃO subir acima de 5.
BROWSER_POOL_SIZE=3

# Timeout em ms para operações do browser e para aguardar context disponível
BROWSER_TIMEOUT_MS=30000

# Encerra browser/contexto após esse tempo ocioso sem requisições.
# 0 desabilita idle shutdown.
BROWSER_IDLE_TTL_MS=900000

# Caminho explícito do browser. Deixe vazio para usar o browser gerenciado
# pelo Playwright (recomendado em Docker/Coolify).
# BROWSER_EXECUTABLE_PATH=

# false = abre janela do browser (útil para debug local)
BROWSER_HEADLESS=true

# Reutiliza a sessão do Astrea entre requisições (evita login repetido)
SESSION_REUSE=true

# Orçamento de logins BEM-sucedidos (qualquer gatilho: 401, sessão sem userId, cold start).
# O Astrea mantém UMA sessão por usuário: se outro processo/pessoa logar com a mesma conta,
# os dois lados se derrubam. Com mais de RELOGIN_MAX_POR_JANELA logins em RELOGIN_JANELA_MS,
# novos logins ficam bloqueados (503 LOGIN_CIRCUIT_OPEN) por RELOGIN_BLOQUEIO_MS, dobrando
# até RELOGIN_BLOQUEIO_MAX_MS. Redeploy/restart zera o orçamento (fica em memória).
# RELOGIN_MAX_POR_JANELA=3
# RELOGIN_JANELA_MS=600000
# RELOGIN_BLOQUEIO_MS=600000
# RELOGIN_BLOQUEIO_MAX_MS=1800000

# ─────────────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────────────
# Janela de tempo em ms (padrão: 60000 = 1 minuto)
RATE_LIMIT_WINDOW_MS=60000

# Máximo de requisições por IP por janela (padrão: 50).
# Excedente recebe 429 com header Retry-After. O varredor de aniversariantes
# do consumer faz ~85 chamadas para 80 clientes em ~1 min — então com pool=5
# e cache de listarClientes, fica perto do limite mas não estoura em uso
# saudável; retry-storm 4× estoura imediatamente.
RATE_LIMIT_MAX_REQUESTS=50

# ─────────────────────────────────────────────────────────────────────
# Fila de Requisições (RequestQueue)
# ─────────────────────────────────────────────────────────────────────
# Tamanho máximo da fila de espera (rejeita com 503 quando cheia)
QUEUE_MAX_SIZE=20

# Timeout em ms para espera na fila (padrão: 60000 = 1 minuto)
QUEUE_TIMEOUT_MS=60000

# ─────────────────────────────────────────────────────────────────────
# Tenant do Astrea (necessário para chamadas GCP Endpoints / users API)
# ─────────────────────────────────────────────────────────────────────
ASTREA_TENANT_ID=6692712561442816

# ─────────────────────────────────────────────────────────────────────
# Gestão Kanban: quadro padrão de cada tipo de atividade criada pela API
# Valores: padrao (quadro marcado como padrão no Astrea) | nenhum |
#          Nome do Quadro | Nome do Quadro > Nome da Coluna (nome ou id).
# Sem coluna = primeira coluna do quadro. Cada chamada pode trocar o quadro
# (campo `kanban`) ou pedir `kanban: false`. Tarefa sem prazo fica fora.
# Ausentes: tarefa/prazo = padrao; audiência = AUDIENCIAS & PERICIAS;
#           compromisso = nenhum.
# ─────────────────────────────────────────────────────────────────────
# KANBAN_TAREFA=padrao
# KANBAN_PRAZO=padrao
# KANBAN_AUDIENCIA=AUDIENCIAS & PERICIAS
# KANBAN_COMPROMISSO=nenhum
# Etiqueta acrescentada a toda audiência criada (nome ou id; "nenhuma" desliga).
# Ausente: Audiência.
# ETIQUETA_AUDIENCIA=Audiência
#
# Regras pela natureza (ver src/services/regras-natureza.ts). Formato "chave1,chave2=Alvo; chave3=Alvo";
# "nenhuma" desliga. O que vier na chamada (responsavelId, kanban) sempre vence.
# Responsável padrão de prazo/audiência/tarefa pela etiqueta de área do item ou do processo
# (alvo = id, e-mail ou nome do usuário; nome precisa identificar um único usuário — há dois "DIEGO MONTEIRO ROCHA"):
# RESPONSAVEL_POR_ETIQUETA=Trabalhista=charles@srsadvogados.adv.br; Previdenciário=mariane@srsadvogados.adv.br; Cível,Família,Tributário,Criminal=diego@srsadvogados.adv.br
# Quadro de prazo/tarefa pelo cliente do processo (nome contém a chave; alvo "Quadro" ou "Quadro > Coluna"):
# KANBAN_POR_CLIENTE=SINDISMED=Demandas do SINDISMED

# Conta de TESTE usada só pelos scripts de discovery (scripts/discover-*.mjs).
# Use uma conta diferente da ASTREA_EMAIL para não derrubar a sessão da produção.
DISC_EMAIL=conta.teste@escritorio.com
DISC_PASS=senha_da_conta_de_teste
